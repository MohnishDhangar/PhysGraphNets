{
  "dataset": "outputs/gnn_repairs_20261029/fresh_dataset/dataset_manifest.json",
  "normalization": "outputs/gnn_repairs_20261029/fresh_normalization.json",
  "seeds": [
    0,
    1,
    2
  ],
  "epochs": 800,
  "width": 32,
  "depth": 3,
  "batch_size": 7,
